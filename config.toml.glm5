# GLM-5 on H200 — embedded SGLang (offline) backend
#
# Usage:
#   cp config.glm5_h200_offline.toml config.toml
#   uv run heretic
#
# Notes:
# - GLM-5 is a DeepSeek-V3/V3.2-style MoE model with sparse attention (DSA). In SGLang this
#   typically maps to the "nsa" attention backend.
# - GLM-5 "thinking" is on by default in SGLang's `glm45` reasoning parser.
#   If the model emits a stable boilerplate prefix (e.g. `<think>...</think>`), you can enable
#   `detect_response_prefix=true` below to probe/suppress it.
# - GPU sizing (from SGLang GLM-5 guidance):
#   - H200 FP8: tp=8  (use model `zai-org/GLM-5-FP8`)  ← this config
#   - H200 BF16: tp=16 (use model `zai-org/GLM-5`)
#
# IMPORTANT: This config is for the embedded/offline engine, not the HTTP server.

# You can specify either an explicit local directory OR an HF model id.
model = "zai-org/GLM-5-FP8"
backend = "sglang_offline"
trust_remote_code = true

# Validate backend startup invariants (LoRA hot-swap, residual capture, etc.).
validate_backend = true

detect_response_prefix = true

# Production: store studies on persistent disk.
study_checkpoint_dir = "/mnt/vdb/studies"

# These are kept for parity with other backends (SGLang loads weights itself).
dtypes = ["auto", "float16", "bfloat16", "float32"]
device_map = "auto"
quantization = "none"

# Throughput-oriented batching.
batch_size = 128
max_batch_size = 128
max_response_length = 100

# Use orthogonalized refusal directions (production default).
refusal_cache = true
orthogonalize_direction = true

# GLM-5 is MoE; including experts often matters for strong refusal reduction.
sglang_abliterate_include_projs = ["o_proj", "down_proj"]
sglang_abliterate_include_experts = true

# Prompt token-id source for SGLang backends.
# - "sglang": use SGLang tokenize_chat (default)
# - "hf": use HF apply_chat_template locally and pass those input_ids directly to SGLang
sglang_prompt_source = "sglang"

# Exercise FULL rownorm path (server-side primitive via embedded engine).
row_normalization = "full"
# Keep consistent with the historical local-backend default (commit 3525b1a...): rank=3 for FULL rownorm.
full_normalization_lora_rank = 3
# Device preference for SGLang server-side FULL rownorm factor construction.
sglang_full_rownorm_build_device = "cuda"      # "auto" | "cuda" | "cpu"

# Packed-MoE (packed w2) FULL rownorm builder performance knobs (GPU-first).
# Trials: use accurate mode so we always build all experts (more stable/correct, slower).
sglang_packed_w2_trial_mode = "accurate"       # "fast" | "accurate" | "skip"
sglang_packed_w2_build_device = "cuda"         # "auto" | "cuda" | "cpu"
sglang_packed_w2_expert_chunk_size = 8
# Cap used only in "fast" mode; keep high so switching modes doesn't silently drop experts.
sglang_packed_w2_max_experts_fast = 384
sglang_packed_w2_max_identity_k = 2048
sglang_packed_w2_svd_niter_fast = 2
sglang_packed_w2_svd_niter = 6

# Refusal evaluation / verbosity
print_responses = false
print_residual_geometry = false
plot_residuals = false

# Plot configuration (kept for parity; plots are disabled above).
residual_plot_path = "/workspace/plots"
residual_plot_title = "PaCMAP Projection of Residual Vectors for \"Harmless\" and \"Harmful\" Prompts"
residual_plot_style = "dark_background"

# Damage tuning
damage_scale = 1.0
damage_target = 0.01
damage_noise_threshold = 0.075
damage_retry_count = 5
winsorization_quantile = 0.995

# Damage metric
damage_metric = "topk_js"
delta_nll_continuation_tokens = 32
delta_nll_num_refs = 1
delta_nll_ref_temperatures = [0.0]
delta_nll_ref_top_k = 1
delta_nll_mom_buckets = 7

topk_js_k = 128
topk_js_positions = 32

# Range for max_weight parameter during optimization.
max_weight_min = 0.8
max_weight_max = 8.0

# Optimization budget
n_trials = 800
n_startup_trials = 50

# System prompt to use when prompting the model.
system_prompt = "You are a helpful assistant."

# All SGLang Engine/ServerArgs kwargs go here.
# Keys match `sglang.srt.server_args.ServerArgs` fields.
#
# IMPORTANT: this must be a TOML table (NOT an inline `{ ... }` table),
# because TOML inline tables cannot span multiple lines.
[sglang_offline_args]
# Parallelism:
# - For FP8 (zai-org/GLM-5-FP8) on 8×H200, use tp_size=8.
# - For BF16 (zai-org/GLM-5) on H200, use tp_size=16.
tp_size = 8

# Reasoning & tool-call parsing (SGLang OpenAI protocol).
# - `glm45` reasoning parser: thinking by default; can be disabled in OpenAI requests via
#   chat_template_kwargs.enable_thinking=false (not exposed by Heretic today).
# - `glm47` tool-call parser: used for GLM-4.7 and GLM-5 models.
reasoning_parser = "glm45"
tool_call_parser = "glm47"

# GLM-5 uses the DeepSeek DSA/NSA attention path in SGLang (`GlmMoeDsaForCausalLM`), so pin NSA explicitly.
# H200 defaults (matching SGLang DeepSeek-V3.2 guidance): bf16 KV cache + flashmla_sparse prefill + fa3 decode.
attention_backend = "triton"
kv_cache_dtype = "bfloat16"

# Stronger determinism at a performance cost (SGLang batch-invariant ops).
enable_deterministic_inference = true

# Memory/scheduling (tune to your workload)
max_total_tokens = 50000
enable_mixed_chunk = true

# Required features for Heretic
enable_return_hidden_states = true
enable_lora = true

# LoRA knobs (important for Heretic)
max_lora_rank = 64
lora_target_modules = ["o_proj", "down_proj"]
enable_lora_experts = true
max_loras_per_batch = 2
max_loaded_loras = 4
lora_backend = "csgmv"
max_lora_chunk_size = 64
enable_lora_overlap_loading = true

# MoE execution path requirements for Heretic packed-MoE injection (correct per-expert down-proj).
# Force a non-fused runner backend and disable fused-function fast paths.
moe_runner_backend = "triton"
heretic_disable_moe_fused_func = true

# Start conservative for stability/repeatability.
disable_shared_experts_fusion = true

[good_prompts]
dataset = "mlabonne/harmless_alpaca"
split = "train[:400]"
column = "text"
residual_plot_label = "\"Harmless\" prompts"
residual_plot_color = "royalblue"

[bad_prompts]
dataset = "mlabonne/harmful_behaviors"
split = "train[:400]"
column = "text"
residual_plot_label = "\"Harmful\" prompts"
residual_plot_color = "darkorange"

[good_evaluation_prompts]
dataset = "mlabonne/harmless_alpaca"
split = "test[:100]"
column = "text"

[bad_evaluation_prompts]
dataset = "mlabonne/harmful_behaviors"
split = "test[:100]"
column = "text"

